# OpenAQ API (optional — anonymous access works too)
OPENAQ_API_KEY=

# Comma-separated location IDs (overrides built-in defaults)
# OPENAQ_LOCATION_IDS=4795497,4797652,4797660

# Start date for historical pulls (ISO 8601)
# OPENAQ_DATE_FROM=2021-01-01T00:00:00Z

# WAQI API (required for --source waqi)
WAQI_API_KEY=
